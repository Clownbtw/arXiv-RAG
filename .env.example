# Telegram
TELEGRAM_BOT_TOKEN=

# LLM: любой OpenAI-совместимый API. По умолчанию локальная Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# Groq:  LLM_BASE_URL=https://api.groq.com/openai/v1  (ключ и имя модели из личного кабинета)

# Данные: либо папка data/ рядом с кодом, либо HF Dataset
DATA_DIR=data
DATA_REPO=

# Порог reranking (подберите по своим данным; -1000 = выключен)
MIN_RERANK=-1000
